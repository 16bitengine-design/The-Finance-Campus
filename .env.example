# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./finance_campus.db
# YouTube and TikTok credentials will be added when publishing adapters are implemented.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Buffer GraphQL publishing (keep real values in GitHub Actions Secrets)
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
BUFFER_YOUTUBE_CHANNEL_ID=
BUFFER_TIKTOK_CHANNEL_ID=
BUFFER_PUBLISH_ENABLED=false
