{
  "name": "@finance-campus/remotion-renderer",
  "private": true,
  "version": "0.1.0",
  "description": "Remotion composition engine for The Finance Campus",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "render:demo": "remotion render src/index.ts FinanceCampusDemo out/finance-campus-demo.mp4",
    "typecheck": "tsc --noEmit",
    "render:sample": "remotion render src/index.ts FinanceCampusMonochromeSample out/finance-campus-monochrome-sample.mp4 --codec=h264 --crf=23",
    "render:cinematic": "remotion render src/index.ts FinanceCampusCinematicCartoon out/finance-campus-cinematic-cartoon.mp4 --codec=h264 --crf=20"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "remotion": "^4.0.0",
    "roughjs": "^4.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3"
  }
}
